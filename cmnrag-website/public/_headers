# 静态资源缓存（2026-11-12）。默认 max-age=0 会让每次打开页面都逐个回 Cloudflare 节点验证。
# HTML、changelog.json 保持默认（每次验证），保证内容即时更新。
# 只作用于静态资源，不影响 /api/* 等 Worker 响应。

# Vite 构建产物文件名带哈希，内容变则文件名变
/schedule/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 无版本号的样式与脚本：1 小时（改动后读者最多 1 小时内更新）
/site.css
  Cache-Control: public, max-age=3600
/tokens.css
  Cache-Control: public, max-age=3600
/auth.js
  Cache-Control: public, max-age=3600
/navigation.js
  Cache-Control: public, max-age=3600
/proofreading/workbench.css
  Cache-Control: public, max-age=3600
/proofreading/workbench.js
  Cache-Control: public, max-age=3600
/proofreading/anchors.js
  Cache-Control: public, max-age=3600
/proofreading/display-marks.js
  Cache-Control: public, max-age=3600
/proofreading/network-errors.js
  Cache-Control: public, max-age=3600
/proofreading/request.js
  Cache-Control: public, max-age=3600

# 字体与图标基本不变：30 天
/fonts/*
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
/favicon.svg
  Cache-Control: public, max-age=2592000
/favicon-32x32.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
